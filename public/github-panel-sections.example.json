{
  "sections": [
    {
      "type": "notifications",
      "settings": {
        "categories": [
          {
            "id": "review",
            "label": "Review Requested",
            "reasons": ["review_requested"],
            "frequent": true,
            "defaultExpanded": true
          },
          {
            "id": "primary",
            "label": "Primary",
            "reasons": [
              "mention",
              "team_mention",
              "comment",
              "author",
              "state_change",
              "assign",
              "ci_activity"
            ],
            "frequent": true,
            "defaultExpanded": true
          },
          {
            "id": "subscribed",
            "label": "Subscribed",
            "reasons": ["subscribed"],
            "frequent": false,
            "defaultExpanded": false
          },
          {
            "id": "noise",
            "label": "Noise",
            "fallback": true,
            "frequent": false,
            "defaultExpanded": false
          }
        ]
      }
    },
    {
      "type": "group",
      "id": "prs",
      "title": "PRs",
      "defaultExpanded": true,
      "sections": [
        {
          "type": "search",
          "id": "review-requests",
          "title": "Awaiting My Review",
          "query": "is:pr is:open draft:false user-review-requested:@me sort:updated-asc",
          "accentColor": "#3b82f6",
          "defaultExpanded": true,
          "ageThresholds": [
            { "minHours": 0, "color": "#6b7280" },
            { "minHours": 8, "color": "#e5e7eb" },
            { "minHours": 16, "color": "#f59e0b" },
            { "minHours": 72, "color": "#dc2626", "titleColor": "#dc2626" }
          ]
        },
        {
          "type": "search",
          "id": "my-prs",
          "title": "My Open PRs",
          "query": "is:pr is:open author:@me sort:updated-desc",
          "accentColor": "#22c55e",
          "defaultExpanded": true,
          "ageThresholds": [
            { "minHours": 0, "color": "#6b7280" },
            { "minHours": 8, "color": "#e5e7eb" },
            { "minHours": 16, "color": "#f59e0b" },
            { "minHours": 168, "color": "#dc2626", "titleColor": "#dc2626" }
          ]
        }
      ]
    },
    {
      "type": "group",
      "id": "issues",
      "title": "Issues",
      "defaultExpanded": false,
      "sections": [
        {
          "type": "search",
          "id": "my-issues",
          "title": "My Open Issues",
          "query": "is:issue is:open author:@me sort:updated-desc",
          "accentColor": "#a855f7",
          "defaultExpanded": true
        }
      ]
    },
    {
      "type": "dependabot",
      "id": "my-vulns",
      "title": "My Vulnerabilities",
      "repo": "owner/repo",
      "filters": {
        "assignee": "@me",
        "state": "open",
        "severity": "high,critical",
        "scope": "runtime",
        "sort": "updated",
        "direction": "desc"
      },
      "accentColor": "#dc2626",
      "defaultExpanded": true,
      "ageThresholds": [
        { "minHours": 0, "color": "#6b7280" },
        { "minHours": 24, "color": "#e5e7eb" },
        { "minHours": 72, "color": "#f59e0b" },
        { "minHours": 168, "color": "#dc2626", "titleColor": "#dc2626" }
      ]
    }
  ]
}
