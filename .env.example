# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real tokens.

# --- Notion (required) -----------------------------------------------------

# Internal integration token from https://www.notion.so/profile/integrations
# The integration must be shared with the databases and parent page below.
VITE_NOTION_TOKEN=

# Main database where daily blocks and tasks are stored.
# Open the database as a full page; the ID is the 32-char string in the URL.
VITE_NOTION_DATABASE_ID=

# Parent page under which new daily entries are created.
VITE_NOTION_PARENT_PAGE=

# --- Notion schema property names (optional) -------------------------------
# Override these only if your database uses different property names.
# Defaults match a freshly created database.

# Title property on the main DB (default: "Name").
VITE_NOTION_TITLE_PROP=Name

# Date property on the main DB (default: "date").
VITE_NOTION_DATE_PROP=date

# --- Loose ends (optional) -------------------------------------------------
# Separate Notion database for "loose ends" capture.
# The DB needs a title property (default "Name") and a checkbox (default "Done").
VITE_NOTION_LOOSE_ENDS_DB=

# Override the loose-ends property names if your DB uses different ones.
VITE_NOTION_LOOSE_ENDS_TITLE_PROP=Name
VITE_NOTION_LOOSE_ENDS_DONE_PROP=Done

# --- Notion custom emoji (optional) ----------------------------------------
# Custom emoji ID used in rich text blocks. Leave blank to skip.
VITE_NOTION_CUSTOM_EMOJI_ID=

# --- GitHub notifications (optional) ---------------------------------------
# Personal access token with `notifications` scope.
# Without this, the GitHub notifications panel is disabled.
VITE_GITHUB_TOKEN=

# --- Teamwork (optional) ---------------------------------------------------
# Your Teamwork subdomain, e.g. "acme" for acme.teamwork.com.
VITE_TEAMWORK_SITE=
VITE_TEAMWORK_API_KEY=
